[Unit]
Description=Verify BouwFlow runtime, metrics, backup freshness and disk capacity
After=bouwflow-api.service

[Service]
Type=oneshot
User=backup
Group=backup
EnvironmentFile=-/etc/bouwflow/backup.env
ExecStart=/usr/local/bin/check-bouwflow-health
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
