#!/usr/bin/env bash
set -Eeuo pipefail

APP_ROOT="/var/www/bouwflow"
RELEASES="$APP_ROOT/releases"
CURRENT="$APP_ROOT/current"
KEEP_RELEASES=5

release_id="${1:-}"
archive="${2:-}"

if [[ ! "$release_id" =~ ^[0-9a-f]{40}$ ]]; then
    echo "Ongeldig release-id." >&2
    exit 2
fi

if [[ ! -f "$archive" ]]; then
    echo "Release-archief niet gevonden: $archive" >&2
    exit 2
fi

release="$RELEASES/$release_id"
previous=""

if [[ -L "$CURRENT" ]]; then
    previous="$(readlink -f "$CURRENT")"
fi

cleanup_archive() {
    rm -f -- "$archive"
}
trap cleanup_archive EXIT

rm -rf -- "$release"
mkdir -p "$release"
tar -xzf "$archive" -C "$release"
printf 'BUILD_SHA=%s\n' "$release_id" > "$release/release.env"

# Nginx draait als www-data en moet de release kunnen doorkruisen en de
# afzonderlijke publieke bestanden kunnen lezen. Servercode blijft uitsluitend
# voor de eigenaar en de bestaande groep toegankelijk.
chmod 0711 "$release"
find "$release/public" -type d -exec chmod 0755 {} +
find "$release/public" -type f -exec chmod 0644 {} +

ln -sfn "$release" "$APP_ROOT/current.next"
mv -Tf "$APP_ROOT/current.next" "$CURRENT"

restart_api() {
    sudo -n /bin/systemctl restart bouwflow-api.service
}

rollback() {
    if [[ -n "$previous" && -d "$previous" ]]; then
        ln -sfn "$previous" "$APP_ROOT/current.rollback"
        mv -Tf "$APP_ROOT/current.rollback" "$CURRENT"
        restart_api || true
    fi
}

if ! restart_api; then
    rollback
    echo "API kon niet worden herstart; de vorige release is hersteld." >&2
    exit 1
fi

if ! curl --fail --silent --show-error \
    --header 'Host: aifestival.be' \
    --max-time 15 \
    http://127.0.0.1/up >/dev/null; then
    rollback
    echo "Frontend-healthcheck mislukt; de vorige release is hersteld." >&2
    exit 1
fi

if ! curl --fail --silent --show-error \
    --header 'Host: aifestival.be' \
    --max-time 15 \
    http://127.0.0.1/api/health >/dev/null; then
    rollback
    echo "API-healthcheck mislukt; de vorige release is hersteld." >&2
    exit 1
fi

mapfile -t old_releases < <(
    find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' \
        | sort -rn \
        | tail -n "+$((KEEP_RELEASES + 1))" \
        | cut -d' ' -f2-
)

for old_release in "${old_releases[@]}"; do
    if [[ "$old_release" != "$previous" && "$old_release" != "$release" ]]; then
        rm -rf -- "$old_release"
    fi
done

echo "Release $release_id staat in productie."
