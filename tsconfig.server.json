{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  },
  "include": ["server/**/*.ts", "src/domain.ts", "src/progress-measurements.ts", "src/price-revision.ts", "src/administration.ts", "src/belgian-addresses.ts", "src/bim-test-models.ts", "src/class8-demo-calculation.ts", "src/family-home-bim.ts", "src/bosmans-taverniers-bim.ts", "src/bosmans-taverniers-bim.generated.ts", "src/invoice-export.ts", "src/invoice-readiness.ts", "src/lidar-bim.ts"],
  "exclude": ["server/**/*.test.ts"]
}
