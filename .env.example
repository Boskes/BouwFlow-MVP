DATABASE_URL=postgresql://bouwflow:bouwflow@127.0.0.1:5432/bouwflow
DATABASE_SSL=false
API_HOST=127.0.0.1
API_PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://127.0.0.1:3001
UPLOAD_DIR=.data/uploads
TRUST_PROXY=false
RATE_LIMIT_MAX=5000
RATE_LIMIT_WINDOW_MS=60000
BUILD_SHA=development

# Belgische adresautocomplete. Standaard wordt de publieke demo-provider gebruikt.
# Configureer in productie een contractuele BeSt/BeSt-afgeleide endpoint; sleutels blijven server-side.
BELGIAN_ADDRESS_API_URL=https://gratis-postcodedata.nl/api/suggest
BELGIAN_ADDRESS_API_KEY=

# Productie-integratiegateway: uitsluitend HTTPS-origins op deze allowlist.
INTEGRATION_ALLOWED_ORIGINS=
INTEGRATION_TOKENS_JSON={}

# Interne AI-gateway. Het antwoord moet answer en geldige sourceIds bevatten.
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=

# Centrale Microsoft 365-mailbox voor alle inkomende en uitgaande BouwFlow-mail.
# Beperk de app in Exchange Online tot uitsluitend deze mailbox (Mail.Read + Mail.Send).
M365_MAIL_TENANT_ID=
M365_MAIL_CLIENT_ID=
M365_MAIL_CLIENT_SECRET=
M365_MAILBOX=Bouw.Flow@bosis.be

# Optionele legacy HTTPS-relay; alleen gebruikt wanneer M365_MAIL_* niet geconfigureerd is.
QUOTE_MAIL_GATEWAY_URL=
QUOTE_MAIL_GATEWAY_TOKEN=
DOCUMENT_MAIL_GATEWAY_URL=
DOCUMENT_MAIL_GATEWAY_TOKEN=

# Optioneel: HTTP-adapter voor officiële EN16931/Peppol Schematron-validatie.
PEPPOL_VALIDATOR_URL=

# Gecertificeerde Peppol-provideradapter; token uitsluitend server-side bewaren.
PEPPOL_ACCESS_POINT_URL=
PEPPOL_ACCESS_POINT_TOKEN=
PEPPOL_WEBHOOK_SECRET=
PEPPOL_WEBHOOK_PUBLIC_URL=https://example.com/api/integrations/peppol/webhook
PEPPOL_STATUS_POLL_INTERVAL_MS=60000
PEPPOL_NOTIFICATION_URL=
PEPPOL_NOTIFICATION_TOKEN=
# Initiële tenantstandaarden; nadien beheerbaar via Peppol-meldingen.
PEPPOL_ALERT_EMAIL_TO=finance@example.be
PEPPOL_ALERT_TEAMS_TARGETS=FinanciÃ«n
PEPPOL_NOTIFICATION_DISPATCH_INTERVAL_MS=30000
PEPPOL_CRITICAL_SLA_MINUTES=15

# Legacy namen voor een afzonderlijke Peppol-mailadapter. M365_MAIL_* heeft voorrang.
M365_NOTIFICATION_TENANT_ID=
M365_NOTIFICATION_CLIENT_ID=
M365_NOTIFICATION_CLIENT_SECRET=
M365_NOTIFICATION_SENDER=bouwflow@example.be
PEPPOL_TEAMS_WEBHOOKS_JSON={"Financiën":"https://example.logic.azure.com/workflows/..."}

# development gebruikt lokale headers; entra valideert Microsoft Entra ID tokens.
AUTH_MODE=development
TENANT_NAME=BouwFlow Demo
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# SPA-appregistratie en gedelegeerde scope van de API-appregistratie.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_ENTRA_DOMAIN_HINT=

# Alleen voor de versleutelde operationele back-upservice op de VPS.
BACKUP_ROOT=/var/backups/bouwflow
BACKUP_GPG_RECIPIENT=backup@example.be
BACKUP_RETENTION_DAYS=35
MAX_BACKUP_AGE_HOURS=36
MIN_FREE_PERCENT=10
